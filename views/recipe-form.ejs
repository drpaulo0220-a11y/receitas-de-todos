<%- include('partials/header') %>

<section class="page-header">
  <div class="breadcrumbs">Receitas / <%= mode === 'edit' ? 'Editar receita' : 'Nova receita' %></div>
  <h1><%= mode === 'edit' ? 'Editar receita' : 'Publicar nova receita' %></h1>
</section>

<section class="auth-shell">
  <form method="POST" action="<%= mode === 'edit' ? '/recipe/' + recipe.id + '/edit' : '/new-recipe' %>" enctype="multipart/form-data" class="form-grid">
    <label>
      Nome da receita
      <input type="text" name="title" value="<%= recipe ? recipe.title : '' %>" minlength="2" maxlength="120" required />
    </label>

    <label>
      Descrição
      <textarea name="description" minlength="10" maxlength="3000" required><%= recipe ? recipe.description : '' %></textarea>
    </label>

    <div class="form-row">
      <label>
        Categoria
        <select name="category" required>
          <option value="">Selecione</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category %>" <%= recipe && recipe.category === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Estado (opcional)
        <select name="state">
          <option value="">Não informar</option>
          <% states.forEach(([code, name]) => { %>
            <option value="<%= code %>" <%= recipe && recipe.state === code ? 'selected' : '' %>><%= name %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Dificuldade
        <select name="difficulty" required>
          <option value="">Selecione</option>
          <option value="fácil" <%= recipe && recipe.difficulty === 'fácil' ? 'selected' : '' %>>Fácil</option>
          <option value="média" <%= recipe && recipe.difficulty === 'média' ? 'selected' : '' %>>Média</option>
          <option value="difícil" <%= recipe && recipe.difficulty === 'difícil' ? 'selected' : '' %>>Difícil</option>
        </select>
      </label>
    </div>

    <div class="form-row">
      <label>
        Tempo de preparo
        <input type="number" name="prep_time" min="1" max="1440" step="1" value="<%= recipe ? prepTimeMinutes(recipe.prep_time) : '' %>" required />
      </label>
      <label>
        Rendimento
        <input type="text" name="servings" maxlength="80" value="<%= recipe ? recipe.servings : '' %>" required />
      </label>
    </div>

    <div class="image-upload">
      <label>
        Foto da receita
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif" data-image-file />
      </label>
      <p class="form-hint">Escolha uma foto do celular ou computador (JPG, PNG, WEBP ou GIF; até 5 MB).</p>
      <div class="image-preview<%= recipe && recipe.photo_url ? ' is-visible' : '' %>" data-image-preview-wrap <%= recipe && recipe.photo_url ? '' : 'hidden' %>>
        <img src="<%= recipe && recipe.photo_url ? recipe.photo_url : '' %>" alt="Prévia da foto da receita" data-image-preview />
        <span data-image-preview-caption><%= recipe && recipe.photo_url ? 'Foto atual' : 'Prévia da imagem' %></span>
      </div>
      <% if (recipe) { %><%- include('partials/photo-credit', { recipe }) %><% } %>
    </div>

    <label>
      URL da imagem (opcional)
      <input type="url" name="photo_url" value="<%= recipe && recipe.photo_url && !recipe.photo_url.startsWith('/uploads/') && !recipe.photo_url.startsWith('/images/') ? recipe.photo_url : '' %>" placeholder="https://..." data-image-url />
    </label>

    <label>
      Ingredientes (um por linha)
      <textarea name="ingredients" maxlength="12000" required><%= recipe ? recipe.ingredients : '' %></textarea>
    </label>

    <label>
      Passos do preparo (um por linha)
      <textarea name="steps" maxlength="24000" required><%= recipe ? recipe.steps : '' %></textarea>
    </label>

    <button type="submit" class="button"><%= mode === 'edit' ? 'Salvar alterações' : 'Publicar receita' %></button>
  </form>
</section>

<%- include('partials/footer') %>
