<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#cd6d2b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="description" content="<%= metaDescription %>" />
    <title><%= pageTitle || 'Receitas de Todos' %></title>
    <% if (adsenseClientId) { %>
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseClientId %>" crossorigin="anonymous"></script>
    <% } %>
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/images/default-recipe.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container topbar">
        <a href="/" class="brand">
          <span class="brand-mark">🍽️</span>
          <span>Receitas de Todos</span>
        </a>

        <nav class="main-nav" aria-label="Navegação principal">
          <a href="/">Início</a>
          <a href="/recipes">Receitas</a>
          <a href="/about">Sobre</a>
          <a href="/contact">Contato</a>
          <% if (currentUser && currentUser.is_admin) { %>
            <a href="/admin">Admin</a>
          <% } %>
        </nav>

        <div class="user-actions">
          <% if (currentUser) { %>
            <a href="/new-recipe" class="button-secondary">+ Receita</a>
            <a href="/profile">Meu perfil</a>
            <form method="POST" action="/logout">
              <button type="submit" class="button-secondary">Sair</button>
            </form>
          <% } else { %>
            <a href="/login">Entrar</a>
            <a href="/register" class="button">Cadastrar</a>
          <% } %>
        </div>
      </div>
    </header>

    <main class="container">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.type || 'info' %>"><%= flash.message %></div>
      <% } %>
