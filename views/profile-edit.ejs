<%- include('partials/header') %>

<section class="page-header">
  <div class="breadcrumbs">Meu perfil / Editar</div>
  <h1>Editar perfil</h1>
</section>

<section class="auth-shell">
  <form method="POST" action="/profile/edit" enctype="multipart/form-data" class="form-grid">
    <label>
      Nome
      <input type="text" name="name" value="<%= userData.name %>" minlength="2" maxlength="80" required />
    </label>

    <label>
      Biografia
      <textarea name="bio" maxlength="500" placeholder="Conte um pouco sobre você"><%= userData.bio %></textarea>
    </label>

    <label>
      Foto do perfil (JPG, PNG, WEBP ou GIF; até 5 MB)
      <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" data-image-file />
    </label>

    <div class="image-preview is-visible" data-image-preview-wrap>
      <img src="<%= userData.avatar_url || '/images/default-avatar.svg' %>" alt="Prévia da foto de perfil" data-image-preview />
      <span data-image-preview-caption>Foto atual</span>
    </div>

    <label>
      URL de uma foto (opcional)
      <input type="url" name="avatar_url" value="<%= userData.avatar_url && !userData.avatar_url.startsWith('/uploads/') && !userData.avatar_url.startsWith('/images/') ? userData.avatar_url : '' %>" placeholder="https://..." data-image-url />
    </label>

    <div class="inline-actions">
      <button type="submit" class="button">Salvar perfil</button>
      <a href="/profile" class="button-secondary">Cancelar</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
