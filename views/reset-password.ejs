<%- include('partials/header') %>

<section class="auth-shell">
  <h1>Redefinir senha</h1>
  <form method="POST" action="/reset/<%= token %>" class="form-grid">
    <label>
      Nova senha
      <input type="password" name="password" required minlength="7" maxlength="72" autocomplete="new-password" />
    </label>
    <button type="submit" class="button">Salvar nova senha</button>
  </form>
</section>

<%- include('partials/footer') %>
